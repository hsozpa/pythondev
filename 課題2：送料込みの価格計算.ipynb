     "text": [
      "送料として350円かかります\n",
      "送料込みの価格は2330です。\n"
     ]
    }
   ],
   "source": [
    "price = int(input(\"税抜価格を入力してください：\"))\n",
    "total_price = price * 1.1\n",
    "include = 0\n",
    "\n",
    "\n",
    "if total_price >= 2000:\n",
    "    include =  total_price\n",
    "    print(\"送料は無料です\")\n",
    "\n",
    "elif total_price < 2000:\n",
    "    include =  total_price + 350\n",
    "    print(\"送料として350円かかります\")\n",
    "\n",
    "\n",
    "print(f\"送料込みの価格は{include:.0f}です。\")\n"
   ]
  }
 ],
